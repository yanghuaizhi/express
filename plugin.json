{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "express",
  "version": "0.1.0",
  "description": "让日常会话、复杂解释与工作文档更清楚。Clear communication for Codex, designed for Chinese.",
  "author": { "name": "Express contributors" },
  "license": "MIT",
  "keywords": ["codex", "communication", "writing", "chinese", "skill"],
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "interface": {
        "displayName": "Express · 清楚表达",
        "shortDescription": "直接回答，讲清关系，保留必要信息与原意。",
        "developerName": "Express contributors",
        "category": "Productivity",
        "defaultPrompt": ["请用 Express 帮我讲清这个问题。"]
      }
    }
  }
}
